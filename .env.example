DOMAIN=counsel.example.com
# Optional local scanned-PDF OCR. Build the tools into the image and enable extraction.
# INSTALL_OCR=1
# COUNSEL_OCR_ENABLED=1
# COUNSEL_OCR_LANGUAGE=eng
# Free default: model generation requires explicit provider selection.
AI_PROVIDER=evidence
# Optional. Source passages are transmitted to this provider when enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local generation: no model API key required. Choose a model already installed in Ollama.
# AI_PROVIDER=ollama
# OLLAMA_MODEL=your-installed-model
# Docker app reaches the host through this address; use 127.0.0.1 for native Node.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OpenAI-compatible endpoint. Remote API services may charge for use.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=

# To force zero model API calls in the web app, even if other keys are present:
# AI_PROVIDER=evidence
